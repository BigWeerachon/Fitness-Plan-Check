# คัดลอกเป็น .env แล้วใส่ค่าจริง (ดู docs/HUMAN_TASKS.md)
# ค่าที่ขึ้นต้นด้วย EXPO_PUBLIC_ จะถูกฝังในแอป ห้ามใส่ความลับ (secret API key ฯลฯ) ที่นี่
# แอปออฟไลน์ล้วน (D81): คีย์ภายนอกมีแค่ RevenueCat — ไม่มีคีย์ ระบบใช้ร้านค้าจำลองใน dev/พรีวิวเว็บ

# 1 = ใช้ mock adapter (ไม่ต้องมีบัญชีจริง) — มีผลเฉพาะ dev build และพรีวิวเว็บ (release build ไม่ใช้ mock เสมอ ยกเว้นโปรไฟล์ tryout, D85)
EXPO_PUBLIC_USE_MOCKS=0
# สถานการณ์ของ mock สิทธิ์: new | trial_used | trialing | monthly | lifetime | expired | billing_grace | billing_retry
EXPO_PUBLIC_MOCK_SCENARIO=new

# บิลด์ทดลอง APK (D85): ตั้งโดยโปรไฟล์ EAS `tryout` ใน eas.json เท่านั้น — อย่าตั้งที่นี่หรือใน EAS environment
# 1 = ใช้ร้านค้าจำลองแม้เป็น release build + ชื่อ "Fitnese (Test)" + package/bundle id ต่อท้าย .tryout + ป้ายบนจอ
# ห้ามเป็น 1 ตอน build ที่จะส่งสโตร์ (preview/production) — ดู docs/HUMAN_TASKS.md ส่วน 0
# EXPO_PUBLIC_TRYOUT_BUILD=

# RevenueCat public SDK keys (Project → API keys)
EXPO_PUBLIC_RC_IOS_KEY=
EXPO_PUBLIC_RC_ANDROID_KEY=

# URL หน้าเว็บนโยบาย (ใช้ในสโตร์และลิงก์ในแอป ถ้าว่างแอปแสดงฉบับในแอป)
EXPO_PUBLIC_PRIVACY_URL=https://fitnese-legal.vercel.app/privacy
EXPO_PUBLIC_TERMS_URL=https://fitnese-legal.vercel.app/terms

# ตัวระบุแอป (ต้องตรงกับ App Store Connect / Play Console)
APP_BUNDLE_ID=com.example.fitnese
APPLE_TEAM_ID=
# รหัสโปรเจกต์ EAS (ได้จาก `eas init`) — ตั้งใน EAS environment variables ด้วย
EAS_PROJECT_ID=
# slug ของโปรเจกต์บน expo.dev ถ้าไม่ใช่ 'fitnese' (ค่าเริ่มต้น fitnese) — ต้องตรงกับโปรเจกต์ที่ผูกด้วย EAS_PROJECT_ID
# build บนคลาวด์ไม่อ่าน .env → ตั้งเป็น EAS environment variable ด้วย (HUMAN_TASKS ส่วน 0)
APP_SLUG=

# คัดลอกเป็น .env แล้วใส่ค่าจริง (ดู docs/HUMAN_TASKS.md)
# ค่าที่ขึ้นต้นด้วย EXPO_PUBLIC_ จะถูกฝังในแอป ห้ามใส่ความลับ (service role key ฯลฯ) ที่นี่

# 1 = ใช้ mock adapter (ไม่ต้องมีบัญชีจริง) — มีผลเฉพาะ dev build และพรีวิวเว็บ (release build ไม่ใช้ mock เสมอ)
EXPO_PUBLIC_USE_MOCKS=0
# สถานการณ์ของ mock สิทธิ์: new | trial_used | trialing | monthly | lifetime | expired | billing_grace
EXPO_PUBLIC_MOCK_SCENARIO=new

# Supabase (Project Settings → API)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat public SDK keys (Project → API keys)
EXPO_PUBLIC_RC_IOS_KEY=
EXPO_PUBLIC_RC_ANDROID_KEY=

# Google Sign-In (Google Cloud Console → Credentials)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# reversed iOS client id เช่น com.googleusercontent.apps.1234-abcd (ใช้ตอน build เท่านั้น)
GOOGLE_IOS_URL_SCHEME=

# URL หน้าเว็บนโยบาย (ใช้ในสโตร์และลิงก์ในแอป ถ้าว่างแอปแสดงฉบับในแอป)
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=

# ตัวระบุแอป (ต้องตรงกับ App Store Connect / Play Console)
APP_BUNDLE_ID=com.example.fitnese
APPLE_TEAM_ID=
